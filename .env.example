# Copy to .env and customize as needed

# =============================================================================
# Paths (all optional - sensible defaults provided)
# =============================================================================

# Base directory for all data artifacts
# DATA_PATH=.data

# Where git repositories are cloned
# REPOSITORY_PATH=.data/repositories

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_LEVEL=INFO

# =============================================================================
# Display
# =============================================================================

# Make tqdm progress bars resize dynamically with the terminal
TQDM_DYNAMIC_NCOLS=1

# =============================================================================
# Performance
# =============================================================================

# Number of parallel workers (default: CPU count)
# MAX_WORKERS=8

# Git clone timeout in seconds (default: 3600 = 1 hour)
# GIT_CLONE_TIMEOUT=3600

# Maximum diff size to store in characters (default: 100000)
# MAX_DIFF_SIZE=100000

# Commits-per-repo threshold at which enrichment uses a full clone instead of
# a blobless clone (default: 100)
# FULL_CLONE_THRESHOLD=100

# =============================================================================
# API Tokens (optional but recommended)
# =============================================================================

# GitHub personal access token - increases API rate limit from 60 to 5000 req/hr
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub API base URL - override to use a caching proxy (default: https://api.github.com)
# GITHUB_API_URL=http://localhost:8045/github

# Hugging Face token - required for some gated datasets
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MoreFixes database connection
# MOREFIXES_DB_HOST=localhost
# MOREFIXES_DB_PORT=5432
